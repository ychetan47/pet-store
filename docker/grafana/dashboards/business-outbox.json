  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Outbox Pending Backlog",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "outbox_pending_count or vector(0)",
          "legendFormat": "Pending Events",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Orders Created vs Confirmed vs Cancelled",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "orders_created_total or vector(0)",
          "legendFormat": "Created",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "orders_confirmed_total or vector(0)",
          "legendFormat": "Confirmed",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "orders_cancelled_total or vector(0)",
          "legendFormat": "Cancelled",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Inventory Reservations Success vs Failed",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "inventory_stock_reserved_total or vector(0)",
          "legendFormat": "Reserved",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "inventory_stock_reservation_failed_total or vector(0)",
          "legendFormat": "Failed",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "inventory_stock_released_total or vector(0)",
          "legendFormat": "Released",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "Transactional Outbox Event Flow",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(outbox_published_total[1m])",
          "legendFormat": "Published / sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "title": "Order State Transitions Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(orders_created_total[1m])",
          "legendFormat": "Orders Created / sec",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(orders_confirmed_total[1m])",
          "legendFormat": "Orders Confirmed / sec",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(orders_cancelled_total[1m])",
          "legendFormat": "Orders Cancelled / sec",
