  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Dead Letter Topic (DLT) Messages",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(dlt_messages_total) or vector(0)",
          "legendFormat": "DLT Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Notification Processing Health",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "notifications_processed_total or vector(0)",
          "legendFormat": "Processed",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "notifications_failed_total or vector(0)",
          "legendFormat": "Failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "title": "Kafka Listener Ingestion Rate (events/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(spring_kafka_listener_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "title": "Kafka Producer Publish Rate (events/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(spring_kafka_template_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "ops" }
      }
    }
  ],
