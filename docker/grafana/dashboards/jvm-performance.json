  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}} used",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}} max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "bytes" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "JVM CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "process_cpu_usage",
          "legendFormat": "{{application}} process",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "system_cpu_usage",
          "legendFormat": "{{application}} system",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "percentunit" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "JVM Threads (Live vs Peak)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{application}} live",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_threads_peak_threads",
          "legendFormat": "{{application}} peak",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "HikariCP Database Connections",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{application}} active",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_idle",
          "legendFormat": "{{application}} idle",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line" }, "unit": "short" }
      }
    }
